<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="SnackLah.Site" %>
<!DOCTYPE html>
<html>
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SnackLah - Online Snack Store</title>
    <link href="Styles/site.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Pacifico&display=swap" rel="stylesheet">
    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form runat="server">
        <!-- Header -->
        <header class="header">
            <div class="header-container">
                <!-- Logo + Welcome -->
                <div class="header-brand">
                    <img src="Images/logo.jpg" alt="SnackLah Logo" class="logo" />
                    <asp:Label ID="lblWelcome" runat="server" CssClass="welcome-label" />
                </div>

                <!-- Navigation -->
                <nav class="main-nav">
                    <ul>
                        <li><a href="Default.aspx" class="nav-link"><i class="fas fa-home"></i> Home</a></li>
                        <li><a href="About.aspx" class="nav-link"><i class="fas fa-info-circle"></i> About</a></li>
                        <li><a href="Products.aspx" class="nav-link"><i class="fas fa-utensils"></i> Menu</a></li>
                        <li><a href="OrderHistory.aspx" class="nav-link"><i class="fas fa-history"></i> Orders</a></li>
                    </ul>
                </nav>

                <!-- User Section -->
                <div class="user-actions">
                    <a href="Cart.aspx" class="cart-btn" title="View Cart">
                        <i class="fas fa-shopping-cart"></i>
                    </a>
                    
                    <asp:LinkButton ID="lnkProfile" runat="server" CssClass="profile-btn" PostBackUrl="~/Login.aspx">
                        <i class="fas fa-user-circle"></i>
                    </asp:LinkButton>

                    <asp:LinkButton ID="lnkLogout" runat="server" Text="Logout" CssClass="logout-btn" OnClick="lnkLogout_Click" />
                </div>
            </div>
        </header>

        <!-- Main Content -->
        <main class="main-content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </main>

        <!-- Footer -->
        <footer class="footer">
            <div class="footer-container">
                <div class="footer-brand">
                    <img src="Images/logo.jpg" alt="SnackLah Logo" class="footer-logo" />
                    <p>Delicious food exclusive for u</p>
                </div>
                
                <div class="footer-links">
                    <h3>Quick Links</h3>
                    <ul>
                        <li><a href="Default.aspx">Home</a></li>
                        <li><a href="Products.aspx">Menu</a></li>
                        <li><a href="About.aspx">About Us</a></li>
                        <li><a href="OrderHistory.aspx">Order</a></li>
                    </ul>
                </div>
                
                <div class="footer-social">
                    <h3>Follow Us</h3>
                    <div class="social-icons">
                        <a href="#" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                        <a href="#" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
                    </div>
                </div>
            </div>
            
            <div class="footer-bottom">
                <p>&copy; <%= DateTime.Now.Year %> SnackLah. All rights reserved.</p>
            </div>
        </footer>
    </form>
</body>
</html>